{
	"name": "reifua",
	"version": "1.0.0",
	"description": "",
	"scripts": {
		"clean": "rimraf dist",
		"start": "npm run serve",
		"serve": "npm run clean && cross-env NODE_ENV=development eleventy --serve",
		"watch": "npm run clean && cross-env NODE_ENV=development eleventy --watch",
		"build": "npm run clean && cross-env NODE_ENV=production eleventy",
		"debug": "DEBUG=Eleventy* npm run build",
		"test": "node --test --test-force-exit --test-timeout=60000 --test-concurrency=2 \"test/*.test.mjs\"",
		"validate": "node _form-engine/tools/validate-config.mjs src/_data/add-property.yml --strict",
		"engine:manifest": "node _form-engine/tools/engine-manifest.mjs",
		"check:add-property": "node _form-engine/tools/check-add-property.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/reifua/main.git"
	},
	"author": "Vladislav K.",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/reifua/main/issues"
	},
	"homepage": "https://github.com/reifua/main#readme",
	"devDependencies": {
		"@11ty/eleventy": "^1.0.2",
		"@tailwindcss/typography": "^0.3.1",
		"cross-env": "^7.0.3",
		"html-minifier": "^4.0.0",
		"luxon": "^2.5.2",
		"rimraf": "^3.0.2",
		"terser": "^4.8.1",
		"linkedom": "^0.18.13"
	},
	"dependencies": {
		"@11ty/eleventy-upgrade-help": "^1.0.1",
		"@tailwindcss/forms": "^0.2.1",
		"eleventy-plugin-tailwindcss": "github:dafiulh/eleventy-plugin-tailwindcss",
		"js-yaml": "^4.1.0"
	}
}